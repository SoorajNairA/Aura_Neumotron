[
  {"name": "above with hysteresis hold, then fault turns it off",
   "ios": {"temp_1": "celsius", "led_1": "bool"},
   "rules": [{"input": "temp_1", "when": "above", "threshold": 26, "release": 24, "output": "led_1", "onValue": true, "offValue": false, "minOnSeconds": null}],
   "steps": [{"t": 0, "inputs": {"temp_1": 20}, "expect": {"led_1": false}},
             {"t": 1, "inputs": {"temp_1": 25}, "expect": {"led_1": false}},
             {"t": 2, "inputs": {"temp_1": 26}, "expect": {"led_1": true}},
             {"t": 3, "inputs": {"temp_1": 25}, "expect": {"led_1": true}},
             {"t": 4, "inputs": {"temp_1": 24}, "expect": {"led_1": false}},
             {"t": 5, "inputs": {"temp_1": 30}, "expect": {"led_1": true}},
             {"t": 6, "inputs": {"temp_1": null}, "expect": {"led_1": false}}]},
  {"name": "below with minOnSeconds; fault overrides the minimum on time",
   "ios": {"soil_1": "percent", "pump_1": "bool"},
   "rules": [{"input": "soil_1", "when": "below", "threshold": 30, "release": 45, "output": "pump_1", "onValue": true, "offValue": false, "minOnSeconds": 5}],
   "steps": [{"t": 0, "inputs": {"soil_1": 50}, "expect": {"pump_1": false}},
             {"t": 1, "inputs": {"soil_1": 29}, "expect": {"pump_1": true}},
             {"t": 2, "inputs": {"soil_1": 46}, "expect": {"pump_1": true}},
             {"t": 7, "inputs": {"soil_1": 46}, "expect": {"pump_1": false}},
             {"t": 8, "inputs": {"soil_1": 20}, "expect": {"pump_1": true}},
             {"t": 9, "inputs": {"soil_1": null}, "expect": {"pump_1": false}}]},
  {"name": "on and off conditions on boolean inputs",
   "ios": {"button_1": "bool", "led_1": "bool", "motion_1": "bool", "relay_1": "bool"},
   "rules": [{"input": "button_1", "when": "on", "threshold": null, "release": null, "output": "led_1", "onValue": true, "offValue": false, "minOnSeconds": null},
             {"input": "motion_1", "when": "off", "threshold": null, "release": null, "output": "relay_1", "onValue": true, "offValue": false, "minOnSeconds": null}],
   "steps": [{"t": 0, "inputs": {"button_1": false, "motion_1": true}, "expect": {"led_1": false, "relay_1": false}},
             {"t": 1, "inputs": {"button_1": true, "motion_1": false}, "expect": {"led_1": true, "relay_1": true}},
             {"t": 2, "inputs": {"button_1": false, "motion_1": true}, "expect": {"led_1": false, "relay_1": false}}]},
  {"name": "later rule on the same output wins",
   "ios": {"soil_1": "percent", "button_1": "bool", "servo_1": "angle"},
   "rules": [{"input": "soil_1", "when": "below", "threshold": 30, "release": 45, "output": "servo_1", "onValue": 90, "offValue": 0, "minOnSeconds": null},
             {"input": "button_1", "when": "on", "threshold": null, "release": null, "output": "servo_1", "onValue": 180, "offValue": 0, "minOnSeconds": null}],
   "steps": [{"t": 0, "inputs": {"soil_1": 50, "button_1": false}, "expect": {"servo_1": 0}},
             {"t": 1, "inputs": {"soil_1": 20, "button_1": true}, "expect": {"servo_1": 180}},
             {"t": 2, "inputs": {"soil_1": 20, "button_1": false}, "expect": {"servo_1": 0}}]},
  {"name": "faulted sensor runs a cooling fan",
   "ios": {"temp_1": "celsius", "fan_1": "bool"},
   "rules": [{"input": "temp_1", "when": "above", "threshold": 26, "release": 24, "output": "fan_1", "onValue": true, "offValue": false, "minOnSeconds": null}],
   "steps": [{"t": 0, "inputs": {"temp_1": 20}, "expect": {"fan_1": false}},
             {"t": 1, "inputs": {"temp_1": null}, "expect": {"fan_1": true}},
             {"t": 2, "inputs": {"temp_1": 20}, "expect": {"fan_1": false}}]},
  {"name": "no release value: off as soon as the condition is false",
   "ios": {"light_1": "percent", "led_1": "bool"},
   "rules": [{"input": "light_1", "when": "below", "threshold": 30, "release": null, "output": "led_1", "onValue": true, "offValue": false, "minOnSeconds": null}],
   "steps": [{"t": 0, "inputs": {"light_1": 29}, "expect": {"led_1": true}},
             {"t": 1, "inputs": {"light_1": 30}, "expect": {"led_1": true}},
             {"t": 2, "inputs": {"light_1": 31}, "expect": {"led_1": false}}]}
]
